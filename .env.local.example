# Copy this file to .env.local and fill in what you need.
# Everything is optional — the app runs locally without any of these.

# --- AI routine generation (optional) ---
# Without this, built-in + program routines still work; only "Generate" is disabled.
ANTHROPIC_API_KEY=sk-ant-...

# --- Cloud accounts / multi-user (optional) ---
# Without these, the app runs in local-only mode (no login, data stays on device).
# Get these from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by the admin dashboard to read across users. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe billing / Pro subscriptions (optional) ---
# Without these, the app is a free product (no upgrade paths shown).
# Use TEST keys (sk_test_…) while developing. NEVER expose the secret to the client.
STRIPE_SECRET_KEY=sk_test_...
# Fill these in by running:  npm run stripe:setup  (creates the Pro product + prices)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
# Webhook signing secret. Local: from `stripe listen …`. Prod: from the Dashboard webhook.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: absolute base URL for Checkout return links (else derived from the request).
# NEXT_PUBLIC_APP_URL=https://guidedreps.com

# --- Soft launch (optional) ---
# Set to "false" for a Free-first launch: all Pro purchase CTAs become "Coming soon"
# and the /app/go-pro checkout route is blocked. Remove it (or set anything else) to
# make Pro live. Existing subscribers keep access + billing management either way.
# NEXT_PUBLIC_PRO_ENABLED=false
